      <span class="row-val" id="vSize">0.42</span>
    </div>
    <div class="row">
      <span class="row-label">noise scale</span>
      <div class="row-ctrl"><input type="range" id="sNoise" min="0.5" max="6" step="0.05" value="2.2"></div>
