    </div>
    <div class="row">
      <span class="row-label">wind chaos</span>
      <div class="row-ctrl"><input type="range" id="sChaos" min="0" max="1" step="0.01" value="0.45"></div>
      <span class="row-val" id="vChaos">0.45</span>
    </div>
    <div class="row">
      <span class="row-label">solid edge</span>
      <div class="row-ctrl"><input type="range" id="sSolidEdge" min="0" max="1" step="0.01" value="0.0"></div>
      <span class="row-val" id="vSolidEdge">0%</span>
    </div>
    <div class="row">
      <span class="row-label">grain</span>
      <div class="row-ctrl"><input type="range" id="sGrain" min="0" max="1" step="0.01" value="0.28"></div>
      <span class="row-val" id="vGrain">0.28</span>
    </div>

    <div class="sec">Colour</div>
    <div class="colour-row">
      <div class="colour-swatch" id="swBg" style="background:#ffffff">
        <input type="color" id="cBg" value="#ffffff">
      </div>
      <span class="colour-label">background</span>
      <span class="colour-hex" id="hBg">#ffffff</span>
    </div>
    <div class="colour-row">
      <div class="colour-swatch" id="swFg" style="background:#ffec00">
        <input type="color" id="cFg" value="#ffec00">
      </div>
      <span class="colour-label">foreground</span>
      <span class="colour-hex" id="hFg">#ffec00</span>
    </div>

    <div class="sec">Live Data — Punta Arenas</div>
    <div class="row">
      <span class="row-label">wind → chaos</span>
      <div class="row-ctrl">
        <label class="toggle">
          <input type="checkbox" id="tWindChaos" checked>
